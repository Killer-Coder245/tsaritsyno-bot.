# ========== ПАРСЕР САЙТА ==========
def parse_new_races():
    """Парсит сайт https://s95.ru/events/tsaritsyno и возвращает список новых забегов [(год, месяц, день, участники), ...]"""
    url = "https://s95.ru/events/tsaritsyno"
    try:
        response = requests.get(url, timeout=15)
        response.raise_for_status()
    except Exception as e:
        print(f"Ошибка при запросе сайта: {e}")
        return []

    soup = BeautifulSoup(response.text, 'html.parser')
    
    # Ищем таблицу с результатами
    table = soup.find('table')
    if not table:
        table = soup.find('div', class_=re.compile(r'results?', re.I))
        if table:
            table = table.find('table')
    
    if not table:
        print("Таблица не найдена на странице")
        return []
    
    rows = table.find_all('tr')
    if len(rows) < 2:
        return []
    
    new_races = []
    for row in rows[1:]:
        cells = row.find_all('td')
        if len(cells) < 3:
            continue
        
        date_str = cells[1].get_text(strip=True)
        participants_str = cells[2].get_text(strip=True)
        
        try:
            day, month, year = map(int, date_str.split('.'))
        except:
            continue
        
        try:
            participants = int(participants_str)
        except:
            continue
        
        new_races.append((year, month, day, participants))
    
    new_races.sort(key=lambda x: (x[0], x[1], x[2]))
    return new_races

def update_from_site():
    """Сравнивает данные с сайтом и локальным файлом, добавляет новые забеги"""
    if not os.path.exists(DATA_FILE):
        print("Локальный файл не найден. Сначала создайте его.")
        return 0
    
    with open(DATA_FILE, 'r') as f:
        existing = json.load(f)
    
    existing_set = set((y, m, d) for y, m, d, _ in existing)
    new_from_site = parse_new_races()
    
    added = 0
    for race in new_from_site:
        key = (race[0], race[1], race[2])
        if key not in existing_set:
            existing.append(list(race))
            added += 1
            print(f"Добавлен новый забег: {race[2]:02d}.{race[1]:02d}.{race[0]} — {race[3]} участников")
    
    if added > 0:
        existing.sort(key=lambda x: (x[0], x[1], x[2]))
        with open(DATA_FILE, 'w') as f:
            json.dump(existing, f, indent=2)
        print(f"Добавлено {added} новых записей")
    
    return added

