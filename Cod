def main():
    global app, scheduler
    app = Application.builder().token(TOKEN).build()
    
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button_handler))
    
    conv_handler = ConversationHandler(
        entry_points=[CommandHandler("add", add_start)],
        states={
            YEAR: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_year)],
            MONTH: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_month)],
            DAY: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_day)],
            COUNT_STATE: [MessageHandler(filters.TEXT & ~filters.COMMAND, add_count)],
        },
        fallbacks=[CommandHandler("cancel", cancel)],
    )
    app.add_handler(conv_handler)
    
    # Настройка автоматического обновления по субботам после 16:00
    scheduler = AsyncIOScheduler()
    # Запускаем каждую субботу в 16:05
    scheduler.add_job(auto_update_site, 'cron', day_of_week='sat', hour=16, minute=5)
    scheduler.start()
    print("Планировщик запущен. Обновление будет происходить каждую субботу в 16:05")
    
    # При запуске один раз обновляем данные с сайта
    print("Обновление данных с сайта при запуске...")
    update_from_site()
    global raw_data
    raw_data = load_data()
    
    # Flask для вебхуков (если нужно)
    import threading
    threading.Thread(target=lambda: flask_app.run(host='0.0.0.0', port=int(os.environ.get('PORT', 8080)))).start()
    
    print("Бот запущен")
    app.run_polling()

if __name__ == "__main__":
