def parse_new_races():
    url = "https://s95.ru/events/tsaritsyno"
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
    }
    try:
        response = requests.get(url, timeout=15, headers=headers)
        response.raise_for_status()
    except Exception as e:
        print(f"Ошибка: {e}")
        return []

    soup = BeautifulSoup(response.text, 'html.parser')
    table = soup.find('table')
    if not table:
        return []
    
    rows = table.find_all('tr')[1:]
    new_races = []
    for row in rows:
        cells = row.find_all('td')
        if len(cells) < 3:
            continue
        try:
            day, month, year = map(int, cells[1].get_text(strip=True).split('.'))
            participants = int(cells[2].get_text(strip=True))
            new_races.append((year, month, day, participants))
        except:
            continue
    return new_races

def update_from_site():
    if not os.path.exists(DATA_FILE):
        return 0
    with open(DATA_FILE, 'r') as f:
        existing = json.load(f)
    existing_set = set((y, m, d) for y, m, d, _ in existing)
    new_from_site = parse_new_races()
    added = 0
    for race in new_from_site:
        key = (race[0], race[1], race[2])
        if key not in existing_set:
            existing.append(list(race))
            added += 1
    if added > 0:
        existing.sort(key=lambda x: (x[0], x[1], x[2]))
        with open(DATA_FILE, 'w') as f:
            json.dump(existing, f, indent=2)
    return added

