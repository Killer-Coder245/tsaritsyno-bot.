async def button_handler(update: Update, context):
    query = update.callback_query
    await query.answer()
    if query.data == "show_all":
        await query.edit_message_text(format_table(build_table()), parse_mode="HTML")
    elif query.data == "show_year":
        years = sorted(set(row[0].split('.')[-1] for row in build_table()))
        keyboard = [[InlineKeyboardButton(str(y), callback_data=f"year_{y}")] for y in years]
        await query.edit_message_text("Выберите год:", reply_markup=InlineKeyboardMarkup(keyboard))
    elif query.data.startswith("year_"):
        year = int(query.data.split("_")[1])
        await query.edit_message_text(format_table(build_table(), year_filter=year), parse_mode="HTML")
    elif query.data == "km_month":
        km, runners = get_current_month_km()
        await query.edit_message_text(f"📏 Километров за месяц: {km} км\n👥 Участников: {runners}")
    elif query.data == "km_last":
        date_str, count, km = get_last_race()
        await query.edit_message_text(f"📏 Последний забег ({date_str}): {km} км\n👥 Участников: {count}")
    elif query.data == "update_site":
        await query.edit_message_text("🔄 Обновляю...")
        added = update_from_site()
        global raw_data
        raw_data = load_data()
        await query.edit_message_text(f"✅ Добавлено {added} новых забегов" if added else "✅ Новых забегов не найдено")

